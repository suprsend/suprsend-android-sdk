<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="obj"
            type="app.suprsend.user.preference.ChannelPreference" />
    </data>

    <!-- Matches iOS ChannelLevelItem: pad 16, radius 5, stroke #D9D9D9, no arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/channel_preference_item_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/prefHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/prefNameTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="@{obj.channel}"
                android:textColor="@color/pref_title_text"
                android:textSize="16sp"
                tools:text="Email" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/prefDescTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/pref_sub_text"
                android:textSize="13sp"
                tools:text="Allow all notifications" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expandedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/expandedTitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:paddingBottom="8dp"
                android:textColor="@color/pref_title_text"
                android:textSize="15sp"
                tools:text="Email Preferences" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/pref_divider" />

            <LinearLayout
                android:id="@+id/allRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <FrameLayout
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/pref_radio_outer" />

                    <View
                        android:id="@+id/allRadioInner"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:background="@drawable/pref_radio_inner"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/pref_all"
                        android:textColor="@color/pref_title_text"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/pref_all_help"
                        android:textColor="@color/pref_sub_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/requiredRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <FrameLayout
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/pref_radio_outer" />

                    <View
                        android:id="@+id/requiredRadioInner"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:background="@drawable/pref_radio_inner"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/pref_required"
                        android:textColor="@color/pref_title_text"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/pref_required_help"
                        android:textColor="@color/pref_sub_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
