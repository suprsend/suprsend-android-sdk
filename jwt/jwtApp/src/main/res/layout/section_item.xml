<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="obj"
            type="app.suprsend.android.preference.RecyclerViewItem.SectionVo" />
    </data>

    <!-- Matches iOS SectionView header: 12 pad, #FAFAFA, radius 6, bottom 12 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/pref_section_bottom"
        android:background="@drawable/pref_section_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sectionNameTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="@{obj.title}"
            android:textColor="@color/pref_title_text"
            android:textSize="16sp"
            tools:text="Transactional Notifications" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sectionDescTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:text="@{obj.description}"
            android:textColor="@color/pref_sub_text"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Non-marketing notifications related to authentication, activity updates, reminders etc."
            tools:visibility="visible" />
    </LinearLayout>
</layout>
